<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LMTrainingDataStudio2.Localization"
        x:Class="LMTrainingDataStudio2.Views.PresetSaveDialog"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource PanelBackgroundBrush}">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22">
        <StackPanel Spacing="14">
            <TextBlock Text="{loc:Loc preset.dialog.title}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc preset.dialog.name}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox x:Name="NameBox" FontSize="12" Padding="8,6"
                         Watermark="{loc:Loc preset.dialog.name}" />
                <TextBlock x:Name="NameError" IsVisible="False"
                           FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc preset.dialog.description}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox x:Name="DescriptionBox" FontSize="12" Padding="8,6"
                         Height="78" AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc common.cancel}"
                        Click="OnCancelClick"
                        Padding="14,7" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                <Button Content="{loc:Loc common.save}"
                        Click="OnSaveClick"
                        Padding="16,7" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
