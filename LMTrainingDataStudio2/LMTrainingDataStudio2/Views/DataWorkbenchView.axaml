<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LMTrainingDataStudio2.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
             xmlns:services="using:LMTrainingDataStudio2.Services"
             xmlns:controls="using:LMTrainingDataStudio2.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="760"
             x:Class="LMTrainingDataStudio2.Views.DataWorkbenchView"
             x:DataType="vm:DataWorkbenchViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.issueError">
            <Setter Property="Foreground" Value="#FF8080" />
        </Style>
        <Style Selector="TextBlock.issueWarning">
            <Setter Property="Foreground" Value="#E0C060" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#888888" />
        </Style>
        <Style Selector="Border.rowCard">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="BorderBrush" Value="#2E2E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.rowCard.inserted">
            <Setter Property="Background" Value="#1B2A20" />
            <Setter Property="BorderBrush" Value="#4E7A5A" />
        </Style>
        <Style Selector="Border.rowCard.match">
            <Setter Property="BorderBrush" Value="#B08A2A" />
        </Style>
        <Style Selector="Border.rowCard.deleted">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="TextBlock.rowJson">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="#D6D6E0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.rowJson.deleted">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="TextBlock.tag">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,420" RowDefinitions="Auto,*" Background="{StaticResource CanvasBackgroundBrush}">

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Height="48"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,0" ColumnSpacing="12">
                <Button Grid.Column="0" Content="{loc:Loc data.open_dataset}"
                        Click="OnOpenDatasetClick"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="12,6" FontSize="12"
                        Background="#4A90D9" Foreground="#FFFFFF"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding SourcePathText}"
                           FontSize="11" Foreground="#AAAAAA"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2" Text="{Binding SourceFileTypeText}"
                           FontSize="11" Foreground="#888888"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="3"
                           Text="{Binding TotalRowsText}"
                           FontSize="11" Foreground="#CCCCCC"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="4" Text="{Binding PositionText}"
                           FontSize="11" Foreground="#888888"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Preview -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <!-- Pagination -->
            <Border DockPanel.Dock="Top" Height="40"
                    Background="#222233"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0"
                            VerticalAlignment="Center">
                    <Button Content="⏮" Command="{Binding FirstPageCommand}"
                            Background="Transparent" Foreground="#CCCCCC" FontSize="12" Padding="8,4"
                            ToolTip.Tip="{loc:Loc data.first_page}" />
                    <Button Content="{loc:Loc data.prev}" Command="{Binding PreviousPageCommand}"
                            Background="Transparent" Foreground="#CCCCCC" FontSize="11" Padding="8,4" />
                    <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="#AAAAAA"
                               VerticalAlignment="Center" Margin="4,0" />
                    <Button Content="{loc:Loc data.next}" Command="{Binding NextPageCommand}"
                            Background="Transparent" Foreground="#CCCCCC" FontSize="11" Padding="8,4" />
                    <Button Content="⏭" Command="{Binding LastPageCommand}"
                            Background="Transparent" Foreground="#CCCCCC" FontSize="12" Padding="8,4"
                            ToolTip.Tip="{loc:Loc data.last_page}" />
                    <Border Width="1" Height="18" Background="#3A3A4E" Margin="6,0" />
                    <TextBlock Text="{loc:Loc data.go_to_row}" FontSize="10" Foreground="#888888"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding GoToRowText, Mode=TwoWay}"
                             Width="90" FontSize="11" VerticalAlignment="Center"
                             Watermark="{loc:Loc data.row}" />
                    <Button Content="{loc:Loc data.go}" Command="{Binding GoToRowCommand}"
                            Background="#3A3A4E" Foreground="#FFFFFF" FontSize="11" Padding="10,4" />
                    <Border Width="1" Height="18" Background="#3A3A4E" Margin="6,0" />
                    <TextBlock Text="{loc:Loc data.page_size}" FontSize="10" Foreground="#888888"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailablePageSizes}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}"
                              Width="86" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Edit toolbar -->
            <Border DockPanel.Dock="Top" Height="38"
                    Background="#1F1F30"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0"
                                VerticalAlignment="Center">
                        <Button Content="{loc:Loc data.insert_above}"
                                Command="{Binding InsertRowAboveCommand}"
                                Background="Transparent" Foreground="#CCCCCC"
                                FontSize="11" Padding="8,4" />
                        <Button Content="{loc:Loc data.insert_below}"
                                Command="{Binding InsertRowBelowCommand}"
                                Background="Transparent" Foreground="#CCCCCC"
                                FontSize="11" Padding="8,4" />
                        <Button Content="{loc:Loc data.duplicate_row}"
                                Command="{Binding DuplicateRowCommand}"
                                Background="Transparent" Foreground="#CCCCCC"
                                FontSize="11" Padding="8,4" />
                        <Button Content="{loc:Loc data.delete_row}"
                                Command="{Binding DeleteRowCommand}"
                                Background="Transparent" Foreground="#FF9090"
                                FontSize="11" Padding="8,4" />
                        <Button Content="{loc:Loc data.restore_row}"
                                Command="{Binding RestoreRowCommand}"
                                Background="Transparent" Foreground="#7FD08A"
                                FontSize="11" Padding="8,4" />
                        <Border Width="1" Height="18" Background="#3A3A4E" Margin="4,0" />
                        <Button Content="↶" Command="{Binding UndoEditCommand}"
                                ToolTip.Tip="{loc:Loc data.undo_edit}"
                                Background="Transparent" Foreground="#CCCCCC"
                                FontSize="13" Padding="8,2" />
                        <Button Content="↷" Command="{Binding RedoEditCommand}"
                                ToolTip.Tip="{loc:Loc data.redo_edit}"
                                Background="Transparent" Foreground="#CCCCCC"
                                FontSize="13" Padding="8,2" />
                        <Border Width="1" Height="18" Background="#3A3A4E" Margin="4,0" />
                        <Button Content="{loc:Loc data.save_edits_as}"
                                Click="OnSaveEditsClick"
                                IsEnabled="{Binding HasPendingEdits}"
                                Background="#4A90D9" Foreground="#FFFFFF"
                                FontSize="11" Padding="10,4" />
                        <Button Content="{loc:Loc data.overwrite_source}"
                                Click="OnOverwriteSourceClick"
                                IsEnabled="{Binding HasPendingEdits}"
                                Background="#3A2020" Foreground="#FFB0B0"
                                FontSize="11" Padding="10,4" />
                        <Button Content="{loc:Loc data.discard_edits}"
                                Command="{Binding DiscardEditsCommand}"
                                Background="Transparent" Foreground="#AAAAAA"
                                FontSize="11" Padding="8,4" />
                        <TextBlock Text="{Binding PendingEditText}"
                                   FontSize="10" Foreground="#E0C060"
                                   VerticalAlignment="Center" Margin="6,0" />
                        <ProgressBar Value="{Binding EditProgress}" Minimum="0" Maximum="1"
                                     Width="80" Height="3" VerticalAlignment="Center"
                                     IsVisible="{Binding IsSavingEdits}" />
                        <TextBlock Text="{Binding EditStatusText}"
                                   FontSize="10" Foreground="#888888"
                                   VerticalAlignment="Center" Margin="4,0"
                                   MaxWidth="360" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                       FontSize="10" Foreground="#777777" Margin="12,6"
                       TextWrapping="Wrap" />

            <!-- Row editor: per-field cells or raw JSON -->
            <Border DockPanel.Dock="Bottom" Height="304"
                    IsVisible="{Binding IsDatasetOpen}"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="10,8">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <TextBlock Text="{loc:Loc data.row_json_editor}" FontSize="10"
                                   Foreground="#888888" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedRow.NumberText}"
                                   FontSize="10" Foreground="#4A90D9"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc data.edit_row_hint}"
                                   FontSize="9" Foreground="#666666"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <TabControl x:Name="RowEditorTabs" Grid.Row="1"
                                SelectedIndex="{Binding SelectedEditorTabIndex, Mode=TwoWay}"
                                Padding="0" Background="Transparent" Margin="0,4">
                        <TabItem Header="{loc:Loc data.fields_tab}">
                            <Grid RowDefinitions="*,Auto" RowSpacing="4">
                                <ListBox ItemsSource="{Binding SelectedRowFields}"
                                         SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                         Background="#1E1E2E" BorderBrush="#2E2E42"
                                         BorderThickness="1" FontSize="10" Margin="0,4,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DatasetFieldViewModel">
                                            <Grid ColumnDefinitions="150,64,*" ColumnSpacing="6" Margin="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Consolas, Menlo, monospace"
                                                           FontSize="10" Foreground="#9CCFF0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                           FontSize="9" Foreground="#777777"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding ValueText, Mode=TwoWay}"
                                                         FontFamily="Consolas, Menlo, monospace"
                                                         FontSize="10" Padding="5,3"
                                                         MinHeight="24"
                                                         Background="#171722" BorderBrush="#33334A" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                    <TextBox Text="{Binding NewFieldName, Mode=TwoWay}"
                                             Width="150" FontSize="10"
                                             Watermark="{loc:Loc data.new_field_name}" />
                                    <Button Content="{loc:Loc data.add_field}"
                                            Command="{Binding AddFieldCommand}"
                                            FontSize="10" Padding="8,3"
                                            Background="#3A3A4E" Foreground="#FFFFFF" />
                                    <Button Content="{loc:Loc data.remove_field}"
                                            Command="{Binding RemoveFieldCommand}"
                                            FontSize="10" Padding="8,3"
                                            Background="#3A2020" Foreground="#FFB0B0" />
                                    <TextBlock Text="{loc:Loc data.fields_not_available}"
                                               FontSize="9" Foreground="#777777"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !FieldsAvailable}" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{loc:Loc data.raw_json_tab}">
                            <TextBox x:Name="RowJsonEditor"
                                     Text="{Binding SelectedJsonText, Mode=TwoWay}"
                                     IsEnabled="{Binding SelectedRow.IsEditable}"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas, Menlo, monospace" FontSize="11"
                                     Background="#1E1E2E" BorderBrush="#2E2E42"
                                     BorderThickness="1" Padding="8,5"
                                     VerticalAlignment="Stretch" Margin="0,4"
                                     Watermark="{loc:Loc data.select_a_row_to_edit}" />
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding RowEditError}" FontSize="10"
                                   Foreground="#FF8080" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Loc data.apply_fields}"
                                Command="{Binding ApplyFieldsCommand}"
                                IsVisible="{Binding FieldsAvailable}"
                                Background="#3A3A4E" Foreground="#FFFFFF"
                                FontSize="11" Padding="12,4" />
                        <Button Grid.Column="2" Content="{loc:Loc data.apply_row_edit}"
                                Command="{Binding ApplyRowEditCommand}"
                                Background="#3A3A4E" Foreground="#FFFFFF"
                                FontSize="11" Padding="12,4" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding !IsDatasetOpen}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="{loc:Loc data.open_a_dataset_to_preview_it_page_by_page}"
                           FontSize="13" Foreground="#888888" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc data.right_panel_convert_search_replace_dedup_shuffle}"
                           FontSize="10" Foreground="#666666" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Virtualized rows -->
            <ListBox ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     SelectionMode="Single"
                     IsVisible="{Binding IsDatasetOpen}"
                     Background="Transparent" BorderThickness="0"
                     Margin="0,4"
                     DoubleTapped="OnRowDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DatasetRowViewModel">
                        <Border Classes="rowCard"
                                Classes.inserted="{Binding IsInserted}"
                                Classes.deleted="{Binding IsDeleted}"
                                Classes.match="{Binding IsSearchMatch}"
                                Margin="6,3">
                            <Grid ColumnDefinitions="48,*">
                                <StackPanel Grid.Column="0" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding NumberText}" FontSize="10"
                                               Foreground="#6A7A8A"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,4,0" />
                                    <TextBlock Classes="tag" Text="{loc:Loc data.row_tag_new}"
                                               Foreground="#7FD08A"
                                               IsVisible="{Binding IsInserted}" />
                                    <TextBlock Classes="tag" Text="{loc:Loc data.row_tag_edited}"
                                               Foreground="#E0C060"
                                               IsVisible="{Binding IsModified}" />
                                    <TextBlock Classes="tag" Text="{loc:Loc data.row_tag_deleted}"
                                               Foreground="#FF8080"
                                               IsVisible="{Binding IsDeleted}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Classes="rowJson"
                                           Classes.deleted="{Binding IsDeleted}"
                                           controls:TextHighlightBehavior.HighlightText="{Binding Preview}"
                                           controls:TextHighlightBehavior.HighlightQuery="{Binding HighlightQuery}"
                                           controls:TextHighlightBehavior.HighlightUseRegex="{Binding HighlightUseRegex}"
                                           controls:TextHighlightBehavior.HighlightCaseSensitive="{Binding HighlightCaseSensitive}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Tool tabs -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,0,0,0">
            <TabControl Padding="0" Background="Transparent">

                <!-- Convert -->
                <TabItem Header="{loc:Loc common.convert}">
                    <ScrollViewer>
                        <StackPanel Margin="14" Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.target_format}" />
                                <ComboBox ItemsSource="{Binding TargetFormats}"
                                          SelectedItem="{Binding SelectedTargetFormat, Mode=TwoWay}"
                                          FontSize="11" HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DatasetFormatOption">
                                            <TextBlock Text="{Binding Name}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.target_file}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding TargetPath, Mode=TwoWay}"
                                             FontSize="10" Watermark="out.jsonl / out.csv / out.parquet" />
                                    <Button Grid.Column="1" Content="…"
                                            Click="OnBrowseTargetClick"
                                            Background="#3A3A4E" Foreground="#FFFFFF"
                                            FontSize="11" Padding="10,4" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc common.convert}"
                                        Command="{Binding ConvertCommand}"
                                        IsEnabled="{Binding !IsConverting}"
                                        Background="#4A90D9" Foreground="#FFFFFF"
                                        FontSize="11" Padding="14,6" />
                                <Button Content="{loc:Loc common.cancel}"
                                        Command="{Binding CancelConversionCommand}"
                                        IsVisible="{Binding IsConverting}"
                                        Background="#3A2020" Foreground="#FF8080"
                                        FontSize="11" Padding="12,6" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding IsConverting}">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc common.progress}" />
                                <ProgressBar Value="{Binding ConversionProgress}" Minimum="0" Maximum="1" Height="4" />
                            </StackPanel>

                            <TextBlock Text="{Binding ConversionSummary}"
                                       FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <StackPanel Spacing="6" IsVisible="{Binding HasConversionErrors}">
                                <TextBlock Text="{loc:Loc data.failed_rows}" FontSize="10" Foreground="#FF8080" />
                                <ListBox ItemsSource="{Binding ConversionErrors}"
                                         Background="#1E1E2E" BorderBrush="#2E2E42"
                                         MaxHeight="240" FontSize="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="10"
                                                       Foreground="#E0A0A0" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Border Background="#1E1E2E" BorderBrush="#2E2E42" BorderThickness="1"
                                    CornerRadius="6" Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sectionTitle" Text="{loc:Loc data.supported_conversions}" />
                                    <TextBlock Text="{loc:Loc data.openai_sharegpt_alpaca_chat_pretrain_dpo_dpo_pre}"
                                               FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc data.unsupported_pairs_fail_explicitly_and_are_listed}"
                                               FontSize="10" Foreground="#777777" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Search / replace -->
                <TabItem Header="{loc:Loc data.search}">
                    <ScrollViewer>
                        <StackPanel Margin="14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.search_replace}" />

                            <TextBox Text="{Binding Search.Query, Mode=TwoWay}"
                                     FontSize="11" Watermark="{loc:Loc data.text_or_regular_expression}" />
                            <TextBox Text="{Binding Search.Replacement, Mode=TwoWay}"
                                     FontSize="11" Watermark="{loc:Loc data.replacement_1_groups_in_regex_mode}" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox IsChecked="{Binding Search.UseRegex, Mode=TwoWay}"
                                          Content="{loc:Loc data.regex}" FontSize="11" />
                                <CheckBox IsChecked="{Binding Search.CaseSensitive, Mode=TwoWay}"
                                          Content="{loc:Loc data.case_sensitive}" FontSize="11" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding Search.CurrentPageOnly, Mode=TwoWay}"
                                      Content="{loc:Loc data.current_page_only}" FontSize="11" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc common.preview}"
                                        Command="{Binding Search.PreviewCommand}"
                                        IsEnabled="{Binding !Search.IsBusy}"
                                        Background="#4A90D9" Foreground="#FFFFFF"
                                        FontSize="11" Padding="14,6" />
                                <Button Content="{loc:Loc data.replace_to_file}"
                                        Command="{Binding Search.ReplaceCommand}"
                                        IsEnabled="{Binding !Search.IsBusy}"
                                        Background="#3A3A4E" Foreground="#FFFFFF"
                                        FontSize="11" Padding="12,6" />
                                <Button Content="{loc:Loc common.cancel}"
                                        Command="{Binding Search.CancelCommand}"
                                        IsVisible="{Binding Search.IsCancellable}"
                                        Background="#3A2020" Foreground="#FF8080"
                                        FontSize="11" Padding="10,6" />
                            </StackPanel>

                            <ProgressBar Value="{Binding Search.Progress}" Minimum="0" Maximum="1"
                                         Height="4" IsVisible="{Binding Search.IsBusy}" />

                            <TextBlock Text="{Binding Search.Summary}" FontSize="10"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.replacement_target}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding Search.TargetPath, Mode=TwoWay}"
                                             FontSize="10" Watermark="replaced.jsonl" />
                                    <Button Grid.Column="1" Content="…"
                                            Click="OnBrowseSearchTargetClick"
                                            Background="#3A3A4E" Foreground="#FFFFFF"
                                            FontSize="11" Padding="10,4" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Classes="sectionTitle"
                                       Text="{loc:Loc data.matches_double_click_to_jump}" />
                            <ListBox ItemsSource="{Binding Search.Matches}"
                                     SelectedItem="{Binding Search.SelectedMatch, Mode=TwoWay}"
                                     DoubleTapped="OnSearchMatchDoubleTapped"
                                     Background="#1E1E2E" BorderBrush="#2E2E42"
                                     MaxHeight="260" FontSize="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetSearchMatchViewModel">
                                        <StackPanel Spacing="2" Margin="2">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{Binding LineText}" FontSize="10"
                                                           Foreground="#6A7A8A" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                                           FontSize="10" Foreground="#AAAAAA" />
                                            </Grid>
                                            <TextBlock Text="{Binding Snippet}" FontSize="10"
                                                       Foreground="#CCCCCC" TextWrapping="Wrap"
                                                       FontFamily="Consolas, Menlo, monospace" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding Search.StatusText}" FontSize="10"
                                       Foreground="#777777" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Transform -->
                <TabItem Header="{loc:Loc data.transform}">
                    <ScrollViewer>
                        <StackPanel Margin="14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.dedup_shuffle_split}" />

                            <CheckBox IsChecked="{Binding Transform.Deduplicate, Mode=TwoWay}"
                                      Content="{loc:Loc data.deduplicate_exact_row_hash}" FontSize="11" />
                            <CheckBox IsChecked="{Binding Transform.Shuffle, Mode=TwoWay}"
                                      Content="{loc:Loc data.shuffle_deterministic_seed}" FontSize="11" />

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.transform_seed}" />
                                <TextBox Text="{Binding Transform.SeedText, Mode=TwoWay}"
                                         FontSize="11" Width="150" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle"
                                           Text="{loc:Loc data.splits_optional_name_ratio_or_name_count}" />
                                <TextBox Text="{Binding Transform.SplitSpecsText, Mode=TwoWay}"
                                         FontSize="11" Watermark="train:0.8, valid:0.2" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.output_file_no_splits}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding Transform.OutputPath, Mode=TwoWay}"
                                             FontSize="10" Watermark="clean.jsonl" />
                                    <Button Grid.Column="1" Content="…"
                                            Click="OnBrowseTransformOutputClick"
                                            Background="#3A3A4E" Foreground="#FFFFFF"
                                            FontSize="11" Padding="10,4" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionTitle" Text="{loc:Loc data.output_directory_splits}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Text="{Binding Transform.OutputDirectory, Mode=TwoWay}"
                                             FontSize="10" Watermark="{loc:Loc data.folder}" />
                                    <Button Grid.Column="1" Content="…"
                                            Click="OnBrowseTransformDirectoryClick"
                                            Background="#3A3A4E" Foreground="#FFFFFF"
                                            FontSize="11" Padding="10,4" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc common.run}"
                                        Command="{Binding Transform.RunCommand}"
                                        IsEnabled="{Binding !Transform.IsBusy}"
                                        Background="#4A90D9" Foreground="#FFFFFF"
                                        FontSize="11" Padding="16,6" />
                                <Button Content="{loc:Loc common.cancel}"
                                        Command="{Binding Transform.CancelCommand}"
                                        IsVisible="{Binding Transform.IsCancellable}"
                                        Background="#3A2020" Foreground="#FF8080"
                                        FontSize="11" Padding="10,6" />
                            </StackPanel>

                            <ProgressBar Value="{Binding Transform.Progress}" Minimum="0" Maximum="1"
                                         Height="4" IsVisible="{Binding Transform.IsBusy}" />

                            <TextBlock Text="{Binding Transform.Summary}" FontSize="10"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <TextBlock Classes="sectionTitle" Text="{loc:Loc common.results}" />
                            <ListBox ItemsSource="{Binding Transform.Results}"
                                     Background="#1E1E2E" BorderBrush="#2E2E42"
                                     MaxHeight="220" FontSize="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetTransformOutputLine">
                                        <TextBlock Text="{Binding Text}" FontSize="10"
                                                   Foreground="#CCCCCC" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding Transform.StatusText}" FontSize="10"
                                       Foreground="#777777" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Statistics -->
                <TabItem Header="{loc:Loc data.stats}">
                    <ScrollViewer>
                        <StackPanel Margin="14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.dataset_statistics}" />

                            <CheckBox IsChecked="{Binding Statistics.IncludeDuplicates, Mode=TwoWay}"
                                      Content="{loc:Loc data.compute_duplicate_rate_slower}" FontSize="11" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc data.compute}"
                                        Command="{Binding Statistics.ComputeCommand}"
                                        IsEnabled="{Binding !Statistics.IsBusy}"
                                        Background="#4A90D9" Foreground="#FFFFFF"
                                        FontSize="11" Padding="14,6" />
                                <Button Content="{loc:Loc common.cancel}"
                                        Command="{Binding Statistics.CancelCommand}"
                                        IsVisible="{Binding Statistics.IsCancellable}"
                                        Background="#3A2020" Foreground="#FF8080"
                                        FontSize="11" Padding="10,6" />
                            </StackPanel>

                            <ProgressBar Value="{Binding Statistics.Progress}" Minimum="0" Maximum="1"
                                         Height="4" IsVisible="{Binding Statistics.IsBusy}" />

                            <TextBlock Text="{Binding Statistics.Summary}" FontSize="10"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Statistics.Metrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetMetric">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#AAAAAA" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10"
                                                       Foreground="#E0E0E0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.roles}" />
                            <ItemsControl ItemsSource="{Binding Statistics.RoleCounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetMetric">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#AAAAAA" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10"
                                                       Foreground="#E0E0E0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.length_buckets_characters}" />
                            <ItemsControl ItemsSource="{Binding Statistics.LengthBuckets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetMetric">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#AAAAAA" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10"
                                                       Foreground="#E0E0E0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.formats}" />
                            <ItemsControl ItemsSource="{Binding Statistics.FormatCounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetMetric">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#AAAAAA" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10"
                                                       Foreground="#E0E0E0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Statistics.StatusText}" FontSize="10"
                                       Foreground="#777777" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Validate -->
                <TabItem Header="{loc:Loc common.validate}">
                    <ScrollViewer>
                        <StackPanel Margin="14" Spacing="10">
                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.quality_validation}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{loc:Loc data.max_issues}" FontSize="10" Foreground="#888888"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Validation.MaxIssuesText, Mode=TwoWay}"
                                         FontSize="11" Width="90" HorizontalAlignment="Left" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc common.validate}"
                                        Command="{Binding Validation.ValidateCommand}"
                                        IsEnabled="{Binding !Validation.IsBusy}"
                                        Background="#4A90D9" Foreground="#FFFFFF"
                                        FontSize="11" Padding="14,6" />
                                <Button Content="{loc:Loc common.cancel}"
                                        Command="{Binding Validation.CancelCommand}"
                                        IsVisible="{Binding Validation.IsCancellable}"
                                        Background="#3A2020" Foreground="#FF8080"
                                        FontSize="11" Padding="10,6" />
                            </StackPanel>

                            <ProgressBar Value="{Binding Validation.Progress}" Minimum="0" Maximum="1"
                                         Height="4" IsVisible="{Binding Validation.IsBusy}" />

                            <TextBlock Text="{Binding Validation.Summary}" FontSize="10"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                <TextBlock Text="{loc:Loc data.severity_filter}" FontSize="10"
                                           Foreground="#888888" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" FontSize="11" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Validation.SeverityOptions}"
                                          SelectedItem="{Binding Validation.SelectedSeverityOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ValidationSeverityOption">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="{loc:Loc data.code_filter}" FontSize="10"
                                           Foreground="#888888" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3" FontSize="11" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Validation.CodeOptions}"
                                          SelectedItem="{Binding Validation.SelectedCodeOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ValidationCodeOption">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Text="{loc:Loc data.group_by}" FontSize="10"
                                           Foreground="#888888" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" FontSize="11" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Validation.GroupModes}"
                                          SelectedItem="{Binding Validation.SelectedGroupMode, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ValidationGroupModeOption">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="{Binding Validation.FilterSummary}" FontSize="9"
                                       Foreground="#777777" />

                            <TextBlock Classes="sectionTitle"
                                       Text="{loc:Loc data.issues_double_click_to_jump}" />
                            <ListBox ItemsSource="{Binding Validation.FilteredIssues}"
                                     IsVisible="{Binding !Validation.IsGrouped}"
                                     SelectedItem="{Binding Validation.SelectedIssue, Mode=TwoWay}"
                                     DoubleTapped="OnIssueDoubleTapped"
                                     Background="#1E1E2E" BorderBrush="#2E2E42"
                                     MaxHeight="260" FontSize="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DatasetIssueViewModel">
                                        <StackPanel Spacing="2" Margin="2">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{Binding LineText}" FontSize="10"
                                                           Foreground="#6A7A8A" />
                                                <TextBlock Grid.Column="1" Text="{Binding CodeText}"
                                                           FontSize="10" Foreground="#AAAAAA" />
                                                <TextBlock Grid.Column="2" Text="{Binding PathText}"
                                                           FontSize="10" Foreground="#777777"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" FontSize="10"
                                                       Foreground="#CCCCCC" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TreeView ItemsSource="{Binding Validation.IssueTree}"
                                      IsVisible="{Binding Validation.IsGrouped}"
                                      SelectedItem="{Binding Validation.SelectedTreeNode, Mode=TwoWay}"
                                      DoubleTapped="OnIssueTreeDoubleTapped"
                                      Background="#1E1E2E" BorderBrush="#2E2E42"
                                      MaxHeight="260" FontSize="10">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="vm:ValidationIssueNodeViewModel"
                                                      ItemsSource="{Binding Children}">
                                        <StackPanel Spacing="2" Margin="2">
                                            <TextBlock Text="{Binding Header}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#DDDDDD"
                                                       IsVisible="{Binding IsGroup}" />
                                            <StackPanel Spacing="2" IsVisible="{Binding IsLeaf}">
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding LineText}" FontSize="10"
                                                               Foreground="#6A7A8A" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CodeText}"
                                                               FontSize="10" Foreground="#AAAAAA" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PathText}"
                                                               FontSize="10" Foreground="#777777"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Text="{Binding Message}" FontSize="10"
                                                           Foreground="#CCCCCC" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <TextBlock Text="{loc:Loc data.issue_list_is_capped_totals_keep_counting_after}"
                                       FontSize="9" Foreground="#666666"
                                       IsVisible="{Binding Validation.IssuesTruncated}" />

                            <Border Height="1" Background="#3A3A4E" Margin="0,4" />

                            <TextBlock Classes="sectionTitle" Text="{loc:Loc data.auto_fix_jsonl_only}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Loc data.preview_fixes}"
                                        Command="{Binding Validation.PreviewFixesCommand}"
                                        IsEnabled="{Binding !Validation.IsBusy}"
                                        Background="#3A3A4E" Foreground="#FFFFFF"
                                        FontSize="11" Padding="12,6" />
                                <Button Content="{loc:Loc data.write_fixed_copy}"
                                        Command="{Binding Validation.WriteFixesCommand}"
                                        IsEnabled="{Binding !Validation.IsBusy}"
                                        Background="#3A3A4E" Foreground="#FFFFFF"
                                        FontSize="11" Padding="12,6" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding Validation.FixTargetPath, Mode=TwoWay}"
                                         FontSize="10" Watermark="fixed.jsonl" />
                                <Button Grid.Column="1" Content="…"
                                        Click="OnBrowseFixTargetClick"
                                        Background="#3A3A4E" Foreground="#FFFFFF"
                                        FontSize="11" Padding="10,4" />
                            </Grid>

                            <TextBlock Text="{Binding Validation.FixSummary}" FontSize="10"
                                       Foreground="#AAAAAA" TextWrapping="Wrap" />

                            <ListBox ItemsSource="{Binding Validation.FixSamples}"
                                     IsVisible="{Binding Validation.HasFixPreview}"
                                     Background="#1E1E2E" BorderBrush="#2E2E42"
                                     MaxHeight="220" FontSize="10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:DatasetFixSample">
                                        <StackPanel Spacing="2" Margin="2">
                                            <TextBlock Text="{Binding LineNumber}"
                                                       FontSize="10" Foreground="#6A7A8A" />
                                            <TextBlock Text="{Binding Fixed}" FontSize="10"
                                                       Foreground="#A0D0A0" TextWrapping="Wrap"
                                                       FontFamily="Consolas, Menlo, monospace" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding Validation.StatusText}" FontSize="10"
                                       Foreground="#777777" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>