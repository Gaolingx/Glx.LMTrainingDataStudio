<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LMTrainingDataStudio2.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
             xmlns:controls="using:LMTrainingDataStudio2.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="LMTrainingDataStudio2.Views.RecipeCanvasView"
             x:DataType="vm:MainWindowViewModel">

    <Panel>
        <!-- Grid background follows pan and zoom -->
        <controls:GridBackground Name="GridBackground"
                                 IsHitTestVisible="False"
                                 LineBrush="{DynamicResource CanvasGridBrush}" />

        <Canvas Name="CanvasArea" Background="Transparent"
                ClipToBounds="True" />

        <!-- Empty state hint -->
        <TextBlock Text="{loc:Loc canvas.double_click_to_add_a_block_or_drag_from_the_blo}"
                   FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !Blocks.Count}" />

        <!-- Mini-map (Bottom Right, above floating controls) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="160" Height="100"
                Margin="0,0,16,60"
                Background="{DynamicResource StatusBarBackgroundBrush}" CornerRadius="4"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Opacity="0.9"
                Cursor="Hand">
            <Canvas Name="MiniMapCanvas" ClipToBounds="True" />
        </Border>
    </Panel>
</UserControl>
