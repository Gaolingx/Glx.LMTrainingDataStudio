<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LMTrainingDataStudio2.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
        xmlns:views="using:LMTrainingDataStudio2.Views"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="LMTrainingDataStudio2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding DocumentTitle}"
        Icon="/Assets/app-icon.png"
        MinWidth="1280" MinHeight="720"
        Width="1440" Height="900"
        Background="{StaticResource CanvasBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <!-- Recipe Header (48px) -->
        <Border DockPanel.Dock="Top" Height="48"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- File menu -->
                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="{loc:Loc main.file}">
                        <MenuItem Header="{loc:Loc main.new}" Click="OnNewRecipeClick" InputGesture="Ctrl+N" />
                        <MenuItem Header="{loc:Loc main.new_from_sample}" Click="OnNewFromSampleClick" />
                        <MenuItem x:Name="PresetsMenuItem" Header="{loc:Loc menu.new_from_preset}"
                                  SubmenuOpened="OnPresetsSubmenuOpened" />
                        <MenuItem Header="{loc:Loc main.open}" Click="OnOpenRecipeClick" InputGesture="Ctrl+O" />
                        <MenuItem x:Name="RecentFilesMenuItem" Header="{loc:Loc main.recent}" SubmenuOpened="OnRecentFilesSubmenuOpened" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.save}" Click="OnSaveRecipeClick" InputGesture="Ctrl+S" />
                        <MenuItem Header="{loc:Loc main.save_as}" Click="OnSaveAsRecipeClick" InputGesture="Ctrl+Shift+S" />
                        <Separator />
                        <MenuItem Header="{loc:Loc menu.save_as_preset}" Click="OnSaveAsPresetClick" />
                        <MenuItem Header="{loc:Loc menu.import_preset}" Click="OnImportPresetClick" />
                    </MenuItem>
                </Menu>

                <!-- App Icon / Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="⚗️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding RecipeName, Mode=TwoWay}"
                             FontSize="14" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF"
                             VerticalAlignment="Center"
                             MinWidth="200" />
                    <TextBlock Text="●" FontSize="10" Foreground="#F5A623"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               IsVisible="{Binding IsDirty}"
                               ToolTip.Tip="{loc:Loc main.unsaved_changes}" />
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Column="2" />

                <!-- Editor / Executions / Data Toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                    <Button Content="{loc:Loc main.editor}" Command="{Binding SwitchToEditorCommand}"
                            Classes.accent="{Binding IsEditorView}"
                            Padding="12,6" FontSize="12" />
                    <Button Content="{loc:Loc common.executions}" Command="{Binding SwitchToExecutionsCommand}"
                            Classes.accent="{Binding IsExecutionsView}"
                            Padding="12,6" FontSize="12" />
                    <Button Content="{loc:Loc main.data}" Command="{Binding SwitchToDataCommand}"
                            Classes.accent="{Binding IsDataView}"
                            Padding="12,6" FontSize="12" />
                </StackPanel>

                <!-- Settings -->
                <Button Grid.Column="4" Content="⚙" FontSize="16"
                    Command="{Binding OpenSettingsCommand}"
                        Background="Transparent" Foreground="#AAAAAA"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        Padding="8,4" />
            </Grid>
        </Border>

        <!-- Status Bar (28px) -->
        <Border DockPanel.Dock="Bottom" Height="28"
                Background="{StaticResource StatusBarBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#AAAAAA" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalLinesText}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#888888" />
                <ProgressBar Grid.Column="2" Value="{Binding Progress}"
                             Minimum="0" Maximum="1"
                             Height="3" VerticalAlignment="Center"
                             Margin="12,0"
                             IsVisible="{Binding IsRunning}" />
                <TextBlock Grid.Column="3" Text="{Binding CurrentFilePath}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#888888" MaxWidth="300"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding MemoryUsage}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#888888" />
                <TextBlock Grid.Column="5" Text="{Binding CanvasZoomText}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"
                           Foreground="#888888" />
            </Grid>
        </Border>

        <Grid>
        <!-- Main Content: Three-Column Layout -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              IsVisible="{Binding IsEditorView}">

            <!-- Block Sheet Panel (200px) -->
            <Grid Grid.Column="0">
                <!-- Collapsed state: show expand button -->
                <Border Width="24"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0"
                        IsVisible="{Binding !IsBlockSheetVisible}">
                    <Button Content="▶" FontSize="10"
                            Command="{Binding ToggleBlockSheetCommand}"
                            Background="Transparent" Foreground="#888888"
                            Padding="4,2" VerticalAlignment="Top" Margin="0,8,0,0"
                            ToolTip.Tip="{loc:Loc main.show_blocks}" />
                </Border>

                <!-- Expanded state: full panel -->
                <Border Width="200"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0"
                        IsVisible="{Binding IsBlockSheetVisible}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="36"
                                Background="{StaticResource HeaderBackgroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="BlocksHeader" Text="{loc:Loc shell.block_library}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0"
                                           Foreground="#CCCCCC" />
                                <Button Grid.Column="1" Content="◀" FontSize="10"
                                        Command="{Binding ToggleBlockSheetCommand}"
                                        Background="Transparent" Foreground="#888888"
                                        Padding="6,2" Margin="0,0,4,0"
                                        ToolTip.Tip="{loc:Loc main.hide_blocks}" />
                            </Grid>
                        </Border>

                        <ScrollViewer>
                            <StackPanel Margin="8">
                                <TextBlock Text="{loc:Loc shell.workflow_presets}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#888888"
                                           Margin="4,2,4,4" />
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecipePresetViewModel">
                                            <Border Margin="0,3" Padding="10,7"
                                                    CornerRadius="6"
                                                    Background="#232336"
                                                    BorderBrush="#34344A" BorderThickness="1"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{Binding Description}"
                                                    PointerPressed="OnPresetPointerPressed">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                                       FontWeight="SemiBold" Foreground="#D8D8EE" />
                                                            <TextBlock Text="{loc:Loc preset.custom_badge}" FontSize="8"
                                                                       Foreground="#7B61FF" VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsCustom}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="9"
                                                                   Foreground="#777788" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="×"
                                                            IsVisible="{Binding IsCustom}"
                                                            ToolTip.Tip="{loc:Loc preset.delete.tooltip}"
                                                            Click="OnDeletePresetClick"
                                                            PointerPressed="OnDeletePresetPointerPressed"
                                                            Background="Transparent" Foreground="#FF8080"
                                                            FontSize="12" Padding="6,0"
                                                            VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="#3A3A4E" Margin="2,8" />
                                <TextBlock Text="{loc:Loc shell.building_blocks}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#888888"
                                           Margin="4,2,4,4" />

                                <ItemsControl ItemsSource="{Binding BlockTemplates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BlockTemplateViewModel">
                                            <Border Margin="0,4" Padding="10,8"
                                                    CornerRadius="6"
                                                    Background="#2A2A3E"
                                                    BorderBrush="#3A3A4E" BorderThickness="1"
                                                    Cursor="Hand"
                                                    PointerPressed="OnBlockTemplatePointerPressed">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding IconText}" FontSize="14" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#E0E0E0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                                               Foreground="#888888" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Left GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="Transparent"
                          IsVisible="{Binding IsBlockSheetVisible}" />

            <!-- Canvas Area (Center) -->
            <Grid Grid.Column="2">
                <!-- Canvas Background -->
                <Border Background="{StaticResource CanvasBackgroundBrush}">
                    <views:RecipeCanvasView x:Name="RecipeCanvas" DataContext="{Binding}" />
                </Border>

                <!-- Floating Controls (Run / Validate) - Bottom Right -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Orientation="Horizontal" Spacing="8"
                            Margin="0,0,16,16">
                    <Button Content="{loc:Loc main.fit}" Click="OnFitCanvasClick"
                            Padding="12,8" FontSize="12"
                            Background="#2A3A4E" Foreground="#FFFFFF"
                            CornerRadius="6"
                            ToolTip.Tip="{loc:Loc main.fit_all_blocks_into_view}" />
                    <Button Content="{loc:Loc main.layout}" Command="{Binding AutoLayoutBlocksCommand}"
                            Padding="12,8" FontSize="12"
                            Background="#2A3A4E" Foreground="#FFFFFF"
                            CornerRadius="6"
                            ToolTip.Tip="{loc:Loc main.auto_layout_by_topological_layers}" />
                    <Button Content="{loc:Loc main.validate}" Command="{Binding ValidateRecipeCommand}"
                            Padding="14,8" FontSize="12"
                            Background="#2D5A2D" Foreground="#FFFFFF"
                            CornerRadius="6"
                            IsEnabled="{Binding !IsRunning}" />
                    <Button Content="{loc:Loc main.pause}" Command="{Binding PauseRunCommand}"
                            Padding="12,8" FontSize="12"
                            Background="#3A3A4E" Foreground="#FFFFFF"
                            CornerRadius="6"
                            IsVisible="{Binding IsRunning}"
                            IsEnabled="{Binding !IsRunPaused}" />
                    <Button Content="{loc:Loc main.resume}" Command="{Binding ResumeRunCommand}"
                            Padding="12,8" FontSize="12"
                            Background="#2D5A2D" Foreground="#FFFFFF"
                            CornerRadius="6"
                            IsVisible="{Binding IsRunPaused}" />
                    <Button Content="{loc:Loc main.run}" Command="{Binding RunRecipeCommand}"
                            Padding="14,8" FontSize="12"
                            Background="#4A90D9" Foreground="#FFFFFF"
                            CornerRadius="6"
                            IsEnabled="{Binding !IsRunning}" />
                </StackPanel>

            </Grid>

            <!-- Right GridSplitter -->
            <GridSplitter Grid.Column="3" Width="4"
                          Background="Transparent"
                          IsVisible="{Binding IsPropertyPanelVisible}" />

            <!-- Property Panel (320px) -->
            <Grid Grid.Column="4">
                <!-- Collapsed state: show expand button -->
                <Border Width="24"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0"
                        IsVisible="{Binding !IsPropertyPanelVisible}">
                    <Button Content="◀" FontSize="10"
                            Command="{Binding TogglePropertyPanelCommand}"
                            Background="Transparent" Foreground="#888888"
                            Padding="4,2" VerticalAlignment="Top" Margin="0,8,0,0"
                            ToolTip.Tip="{loc:Loc main.show_properties}" />
                </Border>

                <!-- Expanded state: full panel -->
                <Border Width="320"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0"
                        IsVisible="{Binding IsPropertyPanelVisible}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="36"
                                Background="{StaticResource HeaderBackgroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="▶" FontSize="10"
                                        Command="{Binding TogglePropertyPanelCommand}"
                                        Background="Transparent" Foreground="#888888"
                                        Padding="6,2" Margin="4,0,0,0"
                                        ToolTip.Tip="{loc:Loc main.hide_properties}" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc main.properties}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0"
                                           Foreground="#CCCCCC" />
                            </Grid>
                        </Border>

                        <ScrollViewer>
                            <views:PropertyPanelView DataContext="{Binding}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Executions: run list + node/log details -->
        <views:ExecutionsView IsVisible="{Binding IsExecutionsView}" />

        <!-- Data workbench: paginated preview + format conversion -->
        <Border IsVisible="{Binding IsDataView}">
            <views:DataWorkbenchView DataContext="{Binding DataWorkbench}" />
        </Border>
        </Grid>
    </DockPanel>

    <!-- Settings overlay -->
    <Border IsVisible="{Binding IsSettingsVisible}"
            Background="#99000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ZIndex="1000">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#252538"
                    BorderBrush="#4A90D9"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 18 42 0 #66000000">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Height="56"
                            Background="#2D2D44"
                            CornerRadius="12,12,0,0"
                            BorderBrush="#3A3A4E"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" Margin="18,0,12,0">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Loc main.settings}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="{loc:Loc main.cache_theme_and_canvas_interaction_preferences}" FontSize="11" Foreground="#9A9AAD" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseSettingsCommand}"
                                    Background="Transparent"
                                    Foreground="#AAAAAA"
                                    FontSize="14"
                                    Padding="8,4"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="22" Spacing="18">
                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc main.index_cache}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="{loc:Loc main.sqlite_cache_for_large_jsonl_line_offsets_keep_t}" FontSize="11" Foreground="#9A9AAD" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc main.max_cache_size_mb}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxCacheSizeMb, Mode=TwoWay}" Watermark="512" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc main.cache_directory}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CacheDirectory, Mode=TwoWay}" Watermark="tmp/index-cache" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc main.current_cache_size}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding CacheSizeText}" VerticalAlignment="Center" Foreground="#AAAAAA" />
                                        <Button Content="{loc:Loc main.clean_cache}"
                                                Command="{Binding CleanIndexCacheCommand}"
                                                Padding="10,5"
                                                Background="#3A3A4E"
                                                Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc main.llm_api_keys}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <TextBlock Text="{loc:Loc main.stored_in_settings_json_on_this_machine_leave_em}"
                                           FontSize="11" Foreground="#9A9AAD" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc main.openai_api_key}"
                                               VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpenAiApiKey, Mode=TwoWay}"
                                             PasswordChar="●" Watermark="sk-..." />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc main.anthropic_api_key}"
                                               VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnthropicApiKey, Mode=TwoWay}"
                                             PasswordChar="●" Watermark="sk-ant-..." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc main.execution}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc main.layer_parallelism}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxParallelism, Mode=TwoWay}" Watermark="4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc main.node_retries}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NodeRetryCount, Mode=TwoWay}" Watermark="0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc main.run_summary_directory}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RunOutputDirectory, Mode=TwoWay}" Watermark="%TEMP%\LMTrainingDataStudio\runs" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc main.canvas}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc main.enable_grid_snap}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableGridSnap, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc main.grid_snap_size_px}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GridSnapSize, Mode=TwoWay}" Watermark="16" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{loc:Loc settings.language}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="LanguagePicker"
                                          Grid.Column="1"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="loc:LanguageOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Background="#1E1E2E" BorderBrush="#3A3A4E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{loc:Loc main.dark_theme}" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="{loc:Loc common.cancel}"
                                    Command="{Binding CloseSettingsCommand}"
                                    Padding="14,7"
                                    Background="#3A3A4E"
                                    Foreground="#FFFFFF" />
                            <Button Content="{loc:Loc common.apply}"
                                    Command="{Binding ApplySettingsCommand}"
                                    Padding="16,7"
                                    Background="#4A90D9"
                                    Foreground="#FFFFFF" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
