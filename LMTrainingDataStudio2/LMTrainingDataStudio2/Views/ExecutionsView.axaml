<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LMTrainingDataStudio2.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
             xmlns:models="using:LMTrainingDataStudio2.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="LMTrainingDataStudio2.Views.ExecutionsView"
             x:DataType="vm:MainWindowViewModel">

    <Grid ColumnDefinitions="380,Auto,*" Background="{StaticResource CanvasBackgroundBrush}">

        <!-- Run list -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="44"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0">
                        <TextBlock Text="{loc:Loc common.executions}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Executions.StatusFilters}"
                                  SelectedItem="{Binding Executions.StatusFilter, Mode=TwoWay}"
                                  MinWidth="110" FontSize="11" VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="↻"
                                Command="{Binding Executions.RefreshExecutionsCommand}"
                                IsEnabled="{Binding !Executions.IsBusy}"
                                Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="12" Padding="8,4"
                                ToolTip.Tip="{loc:Loc executions.refresh_executions}" />
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding Executions.StatusText}"
                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}"
                           Margin="12,8" TextWrapping="Wrap" />

                <ListBox ItemsSource="{Binding Executions.Runs}"
                         SelectedItem="{Binding Executions.SelectedRunSummary, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ExecutionRunSummary">
                            <StackPanel Spacing="2" Margin="2,5">
                                <TextBlock Text="{Binding RunId}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrightBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" Background="Transparent" />

        <!-- Run details -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Executions.SelectedRunSummary.RunId, TargetNullValue='No run selected'}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" />
                        <TextBlock Text="{Binding Executions.SelectedRun.Status}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Executions.SelectedRunSummary.RecipeId}"
                                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Loc executions.resume_run}"
                            Command="{Binding ResumeExecutionCommand}"
                            CommandParameter="{Binding Executions.SelectedRun}"
                            IsVisible="{Binding Executions.CanResumeSelectedRun}"
                            Padding="12,5" FontSize="11" Margin="0,0,8,0"
                            Background="{DynamicResource SuccessSurfaceBrush}" Foreground="{DynamicResource SuccessBrush}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{loc:Loc common.cancel}"
                            Command="{Binding CancelRunCommand}"
                            IsVisible="{Binding IsRunning}"
                            Padding="12,5" FontSize="11"
                            Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding Executions.SelectedRun, Converter={x:Static ObjectConverters.IsNull}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{loc:Loc executions.select_a_run_to_inspect_node_states_and_logs}"
                           FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock Text="{loc:Loc executions.runs_appear_here_after_executing_a_recipe}"
                           FontSize="10" Foreground="{DynamicResource TextSubtleBrush}" />
            </StackPanel>

            <Grid IsVisible="{Binding Executions.SelectedRun, Converter={x:Static ObjectConverters.IsNotNull}}"
                  RowDefinitions="Auto,Auto,2*,Auto,*" Margin="14">

                <!-- Summary -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24" Margin="0,2,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Loc executions.started}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{Binding Executions.SelectedRun.StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                   FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Loc executions.finished}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{Binding Executions.SelectedRun.FinishedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                   FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Loc executions.output}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{Binding Executions.SelectedRun.OutputDirectory, TargetNullValue='—'}"
                                   FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Executions.SelectedRun.OutputDirectory}" />
                    </StackPanel>
                </StackPanel>

                <!-- Node table header -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,110,80,80,2*" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc executions.block}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc common.status}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc executions.in_rows}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc executions.out_rows}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc common.error}" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                </Grid>

                <!-- Node table -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding Executions.SelectedRun.Nodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NodeExecutionResult">
                                <Grid ColumnDefinitions="2*,110,80,80,2*" Margin="0,3">
                                    <TextBlock Text="{Binding BlockName}" FontSize="11" Foreground="{DynamicResource TextBrightBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputRows}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding OutputRows}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Error}" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="{loc:Loc common.logs}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,4" />

                <Border Grid.Row="4" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="8">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Executions.SelectedRun.Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>