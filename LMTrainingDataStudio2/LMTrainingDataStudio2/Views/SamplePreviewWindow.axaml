<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LMTrainingDataStudio2.Localization"
        xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
        x:Class="LMTrainingDataStudio2.Views.SamplePreviewWindow"
        x:DataType="vm:SamplePreviewViewModel"
        Width="980" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PathText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceDeepBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Rows}"
                     Background="Transparent" BorderThickness="0"
                     Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SamplePreviewRowViewModel">
                        <Border Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="2">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Header}" FontSize="10"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="9"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding ChangeText}"
                                               FontSize="9" Foreground="{DynamicResource WarningBrush}"
                                               IsVisible="{Binding IsDiff}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                      IsVisible="{Binding IsDiff}">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Loc preview.before}" FontSize="9"
                                                   Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBox Text="{Binding Before}" IsReadOnly="True"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 MaxHeight="170" MinHeight="48"
                                                 FontFamily="Consolas, Menlo, monospace" FontSize="10"
                                                 Background="{DynamicResource AppSurfaceDeepBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                                 Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{loc:Loc preview.after}" FontSize="9"
                                                   Foreground="{DynamicResource TextFaintBrush}" />
                                        <TextBox Text="{Binding After}" IsReadOnly="True"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 MaxHeight="170" MinHeight="48"
                                                 FontFamily="Consolas, Menlo, monospace" FontSize="10"
                                                 Background="{DynamicResource AppSurfaceDeepBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                                 Padding="6,4" />
                                    </StackPanel>
                                </Grid>

                                <TextBox Text="{Binding After}" IsReadOnly="True"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         MaxHeight="170" MinHeight="48"
                                         IsVisible="{Binding !IsDiff}"
                                         FontFamily="Consolas, Menlo, monospace" FontSize="10"
                                         Background="{DynamicResource AppSurfaceDeepBrush}" BorderBrush="{DynamicResource AppBorderStrongBrush}"
                                         Padding="6,4" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="{loc:Loc preview.open_in_data}"
                    IsVisible="{Binding CanOpenInData}"
                    Click="OnOpenInDataClick"
                    Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}"
                    Padding="12,6" FontSize="11" />
            <Button Grid.Column="2" Content="{loc:Loc common.cancel}"
                    Click="OnCloseClick"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}"
                    Padding="16,6" FontSize="11" />
        </Grid>
    </Grid>
</Window>
