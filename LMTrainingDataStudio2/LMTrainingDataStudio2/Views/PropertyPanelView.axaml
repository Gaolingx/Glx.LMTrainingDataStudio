<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:LMTrainingDataStudio2.Localization"
             xmlns:m="using:LMTrainingDataStudio2.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LMTrainingDataStudio2.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="LMTrainingDataStudio2.Views.PropertyPanelView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="CleanupRulesTemplate" x:DataType="vm:CleanupRulesEditorViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc property.cleanup_rules}" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <CheckBox Content="{loc:Loc property.normalize_whitespace}" FontSize="11"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding NormalizeWhitespace, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc property.normalize_newlines}" FontSize="11"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding NormalizeNewlines, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc property.strip_ansi_escapes}" FontSize="11"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding StripAnsi, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc property.remove_reasoning_content}" FontSize="11"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding RemoveReasoningContent, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc property.drop_empty_messages}" FontSize="11"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding DropEmptyMessages, Mode=TwoWay}" />

                <TextBlock Text="{loc:Loc property.regex_replacements}" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding RegexReplacements}" x:CompileBindings="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RegexReplacementEditorViewModel">
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4"
                                    Padding="6" Margin="0,2">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                                        <TextBox Grid.Column="0" Text="{Binding Pattern, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Watermark="pattern" />
                                        <Button Grid.Column="1" Content="↑"
                                                Command="{Binding $parent[ItemsControl].DataContext.MoveRegexUpCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Background="{DynamicResource ButtonSurfaceBrush}"
                                                Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                        <Button Grid.Column="2" Content="↓"
                                                Command="{Binding $parent[ItemsControl].DataContext.MoveRegexDownCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Background="{DynamicResource ButtonSurfaceBrush}"
                                                Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                        <Button Grid.Column="3" Content="×"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveRegexCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Background="{DynamicResource ButtonSurfaceBrush}"
                                                Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                    </Grid>
                                    <TextBox Text="{Binding Replacement, Mode=TwoWay}"
                                             FontSize="10" Padding="6,4" Watermark="replacement" />
                                    <CheckBox Content="{loc:Loc property.regex_ignore_case}"
                                              FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                              IsChecked="{Binding IgnoreCase, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding PatternError}" FontSize="10"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                               IsVisible="{Binding PatternError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:Loc property.add_regex_rule}" Command="{Binding AddRegexCommand}"
                        HorizontalAlignment="Left" Padding="10,5"
                        Background="{DynamicResource ButtonSurfaceBrush}"
                        Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="12" Spacing="12">

        <!-- No Selection State -->
        <StackPanel IsVisible="{Binding SelectedBlock, Converter={x:Static ObjectConverters.IsNull}}"
                    Spacing="8" Margin="0,20">
            <TextBlock Text="{loc:Loc property.no_block_selected}" FontSize="13"
                       Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc property.click_a_block_on_the_canvas_to_view_its_properti}"
                       FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Selected Block Properties -->
        <StackPanel IsVisible="{Binding SelectedBlock, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Spacing="12">

            <!-- Block Info Header -->
            <Border Background="{DynamicResource NodeBackgroundBrush}" CornerRadius="6" Padding="12,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedBlock.IconText}" FontSize="16" />
                        <TextBlock Text="{Binding SelectedBlock.DisplayName}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{loc:Loc property.type_label}" />
                        <Run Text="{Binding SelectedBlock.Type}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Node guide -->
            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.node_help}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedBlockHelp}" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedBlockPorts}" FontSize="10"
                               Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Block-level validation error -->
            <TextBlock Text="{Binding SelectedBlock.ConfigError}"
                       FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedBlock.ConfigError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Recipe validation message for this block -->
            <TextBlock Text="{Binding SelectedBlock.ValidationError}"
                       FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       IsVisible="{Binding SelectedBlock.ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Jinja Reference Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc property.jinja_reference_name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox x:Name="BlockNameBox"
                         Text="{Binding SelectedBlock.Name, Mode=TwoWay}"
                         FontSize="12" Padding="8,6"
                         Watermark="e.g. seed_data"
                         GotFocus="OnBlockNameGotFocus"
                         LostFocus="OnBlockNameLostFocus" />
            </StackPanel>

            <!-- Display Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc property.display_name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox x:Name="BlockDisplayNameBox"
                         Text="{Binding SelectedBlock.DisplayName, Mode=TwoWay}"
                         FontSize="12" Padding="8,6"
                         Watermark="{loc:Loc property.block_display_name}"
                         GotFocus="OnBlockDisplayNameGotFocus"
                         LostFocus="OnBlockDisplayNameLostFocus" />
            </StackPanel>

            <!-- Seed configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.SeedEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.seed_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.data_source}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SelectedBlock.SeedEditor.SourcePath, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6"
                                 Watermark="path/to/data.jsonl" />
                        <Button Grid.Column="1" Content="{loc:Loc property.browse}"
                                Click="OnBrowseSeedSourceClick"
                                Padding="10,6" FontSize="11"
                                Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.file_type}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.SeedEditor.FileTypes}"
                              SelectedItem="{Binding SelectedBlock.SeedEditor.FileType, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch" />
                </StackPanel>

                <CheckBox Content="{loc:Loc property.use_index_cache}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.SeedEditor.UseIndexCache, Mode=TwoWay}" />

                <CheckBox Content="{loc:Loc property.seed_streaming}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.SeedEditor.Streaming, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc property.seed_streaming_hint}"
                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- LLM configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.LlmEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.llm_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.provider}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.LlmEditor.Providers}"
                              SelectedItem="{Binding SelectedBlock.LlmEditor.SelectedProvider, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LlmProviderOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.model}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.ModelAlias, Mode=TwoWay}"
                             FontSize="11" Padding="8,6"
                             Watermark="gpt-4o / claude-sonnet-4-5" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc common.temperature}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.Temperature, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc common.max_tokens}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.MaxTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="2048" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc common.timeout_seconds}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.TimeoutSeconds, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="100" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_retries}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.MaxRetries, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="2" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.endpoint_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.Endpoint, Mode=TwoWay}"
                             FontSize="11" Padding="8,6"
                             Watermark="https://api.openai.com/v1" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.prompt}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.Prompt, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="90"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="{loc:Loc property.empty_sends_raw_row_json_supports_field_placehol}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.tool_profile_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.ToolProfileName, Mode=TwoWay}"
                             FontSize="11" Padding="8,6"
                             Watermark="{loc:Loc property.tool_profile_block_name}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.system_prompt}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.SystemPrompt, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="50"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox Content="{loc:Loc property.use_row_messages}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.LlmEditor.UseRowMessages, Mode=TwoWay}" />

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_concurrency}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.MaxConcurrency, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_failure_samples}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.MaxFailureSamples, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="100" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.response_schema}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.ResponseSchema, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="80"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" />
                    <TextBlock Text="{Binding SelectedBlock.LlmEditor.SchemaError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.LlmEditor.SchemaError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="{loc:Loc property.validate_schema}"
                            Command="{Binding SelectedBlock.LlmEditor.ValidateSchemaCommand}"
                            HorizontalAlignment="Left" Padding="10,5"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.failure_output_path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.LlmEditor.FailureOutputPath, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="out/llm-failures.jsonl" />
                </StackPanel>

                <CheckBox Content="{loc:Loc property.continue_on_error}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.LlmEditor.ContinueOnError, Mode=TwoWay}" />

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.input_cost}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.InputCostPerMillionTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.output_cost}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.LlmEditor.OutputCostPerMillionTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc property.api_keys_are_read_from_openai_api_key_anthropic}"
                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Expression configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.ExpressionEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.expression_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Loc property.fluid_template_variables_if_for_and_filters_use}"
                           FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.template}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ExpressionEditor.Template, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="120"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             Watermark="{}{&quot;text&quot;:{{ content | json }}}" />
                    <TextBlock Text="{Binding SelectedBlock.ExpressionEditor.TemplateError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.ExpressionEditor.TemplateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.field_aliases_json_alias_path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ExpressionEditor.FieldsJson, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="70"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" />
                    <TextBlock Text="{Binding SelectedBlock.ExpressionEditor.FieldsError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.ExpressionEditor.FieldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc common.preview}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.sample_row_json}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ExpressionEditor.SampleJson, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="80"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc common.validate}" Command="{Binding SelectedBlock.ExpressionEditor.ValidateTemplateCommand}"
                            Padding="10,5" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                    <Button Content="{loc:Loc property.render_preview}" Command="{Binding SelectedBlock.ExpressionEditor.RenderPreviewCommand}"
                            Padding="10,5" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding SelectedBlock.ExpressionEditor.PreviewError}"
                           FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedBlock.ExpressionEditor.PreviewError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBox Text="{Binding SelectedBlock.ExpressionEditor.PreviewOutput}"
                         IsReadOnly="True"
                         FontSize="10" Padding="8,6" Height="110"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         Background="{DynamicResource InputBackgroundBrush}" />
            </StackPanel>

            <!-- Validator configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.ValidatorEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.validator_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.rule_kind}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.ValidatorEditor.RuleKinds}"
                              SelectedItem="{Binding SelectedBlock.ValidatorEditor.SelectedRuleKind, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ValidatorRuleKindOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.rule_schema}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ValidatorEditor.Rule, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="130"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             Watermark="messages.length > 0  |  JSON Schema" />
                    <TextBlock Text="{Binding SelectedBlock.ValidatorEditor.RuleError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.ValidatorEditor.RuleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="{loc:Loc property.validate_rule}" Command="{Binding SelectedBlock.ValidatorEditor.ValidateRuleCommand}"
                            HorizontalAlignment="Left" Padding="10,5"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <CheckBox Grid.Column="0" Content="{loc:Loc property.match_all_rules}"
                              FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                              IsChecked="{Binding SelectedBlock.ValidatorEditor.MatchAllRules, Mode=TwoWay}" />
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.validator_timeout_ms}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.ValidatorEditor.TimeoutMs, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.additional_rules}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedBlock.ValidatorEditor.AdditionalRules}" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ValidatorRuleEditorViewModel">
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="6" Margin="0,2">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding $parent[ItemsControl].DataContext.RuleKinds}"
                                                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                                      FontSize="10" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="×"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveRuleCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,0,0,0" Padding="6,2"
                                                    Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                        </Grid>
                                        <TextBox Text="{Binding Rule, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4"
                                                 AcceptsReturn="True" TextWrapping="Wrap" />
                                        <CheckBox Content="{loc:Loc property.rule_negate}"
                                                  FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                  IsChecked="{Binding Negate, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Loc property.add_rule}"
                            Command="{Binding SelectedBlock.ValidatorEditor.AddRuleCommand}"
                            HorizontalAlignment="Left" Padding="10,5"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <CheckBox Content="{loc:Loc property.reject_invalid_rows}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.ValidatorEditor.RejectOnFailure, Mode=TwoWay}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.reject_output_path_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ValidatorEditor.RejectOutputPath, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="out/rejected.jsonl" />
                    <TextBlock Text="{loc:Loc property.rejected_rows_are_written_as_linenumber_reason_d}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                    <Button Content="{loc:Loc property.preview_reject}"
                            Click="OnPreviewRejectClick"
                            HorizontalAlignment="Left" Padding="10,5" FontSize="10"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <ContentControl Content="{Binding SelectedBlock.ValidatorEditor.Cleanup}"
                                ContentTemplate="{StaticResource CleanupRulesTemplate}" />
            </StackPanel>

            <!-- Sampler configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.SamplerEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.sampler_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.count}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SamplerEditor.CountText, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="100" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.ratio_0_1}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SamplerEditor.RatioText, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0.1" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.sampler_seed}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SamplerEditor.Seed, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="42" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc property.splits_one_per_line_train_0_8_or_valid_100}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding SelectedBlock.SamplerEditor.SplitsText, Mode=TwoWay}"
                         FontSize="11" Padding="8,6" Height="90"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         Watermark="train:0.8&#10;valid:0.1&#10;test:0.1" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.split_output_directory}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SamplerEditor.OutputDirectory, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="out/splits" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.stratify_field}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SamplerEditor.StratifyField, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="category" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.preview_rows}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SamplerEditor.PreviewRowsText, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="1000" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SelectedBlock.SamplerEditor.StatsPreview}"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" MaxWidth="220" />
                </Grid>

                <TextBlock Text="{Binding SelectedBlock.SamplerEditor.ValidationError}"
                           FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedBlock.SamplerEditor.ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="{loc:Loc property.splits_pass_all_rows_downstream_and_write_one_js}"
                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Query source configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.QuerySourceEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.query_source_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.queries_one_per_line}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.QueriesText, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="100"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="{loc:Loc property.analyze_the_tcp_handshake}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.expansion_mode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding SelectedBlock.QuerySourceEditor.Modes}"
                                  SelectedItem="{Binding SelectedBlock.QuerySourceEditor.SelectedMode, Mode=TwoWay}"
                                  FontSize="11" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuerySetModeOption">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.repeat}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.Repeat, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="1" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.system_prompt_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.SystemPrompt, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="60"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.query_source_path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.SourcePath, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="queries.jsonl" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.query_field}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.QueryField, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="query" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.system_field}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.SystemField, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="system" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.template_variables_json}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.QuerySourceEditor.TemplateVariablesJson, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="60"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" Watermark="{}{'topic':'TCP'}" />
                    <TextBlock Text="{Binding SelectedBlock.QuerySourceEditor.TemplateVariablesError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.QuerySourceEditor.TemplateVariablesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>

            <!-- Simulation configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.SimulationEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.simulation_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.model_transport}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.SimulationEditor.ModelModes}"
                              SelectedItem="{Binding SelectedBlock.SimulationEditor.SelectedModelMode, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimulationModelModeOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.provider}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.SimulationEditor.Providers}"
                              SelectedItem="{Binding SelectedBlock.SimulationEditor.SelectedProvider, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LlmProviderOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.tool_execution}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.SimulationEditor.ToolModes}"
                              SelectedItem="{Binding SelectedBlock.SimulationEditor.SelectedToolMode, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToolExecutionModeOption">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.model}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.ModelAlias, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="gpt-4o / claude-sonnet-4-5" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_rounds}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.MaxRounds, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.concurrency}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.MaxConcurrency, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="1" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc common.temperature}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.Temperature, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc common.max_tokens}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.MaxTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="2048" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc common.timeout_seconds}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.TimeoutSeconds, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="100" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.model_retries}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.ModelMaxRetries, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.endpoint_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.Endpoint, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="https://api.openai.com/v1" />
                </StackPanel>

                <CheckBox Content="{loc:Loc property.emit_incomplete_trajectories}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.SimulationEditor.EmitIncompleteTrajectories, Mode=TwoWay}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.system_prompt_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.SystemPrompt, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="60"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.final_content_scripted_mode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.FinalContent, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Height="50"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc property.failure_samples}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.failure_jsonl_path_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.FailureOutputPath, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="out/failed.jsonl" />
                    <Button Content="{loc:Loc property.preview_failures}"
                            Click="OnPreviewFailuresClick"
                            HorizontalAlignment="Left" Padding="10,5" FontSize="10"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.max_failure_samples_0_unlimited}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.MaxFailureSamples, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="100" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.input_cost_1m}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.InputCostPerMillionTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.output_cost_1m}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.OutputCostPerMillionTokens, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.price_preset}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding SelectedBlock.SimulationEditor.PricePresets}"
                              SelectedItem="{Binding SelectedBlock.SimulationEditor.SelectedPricePreset, Mode=TwoWay}"
                              FontSize="11" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="m:ModelPricePreset">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.requests_per_minute}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.RequestsPerMinute, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{loc:Loc property.stream_deltas}"
                              FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom"
                              IsChecked="{Binding SelectedBlock.SimulationEditor.StreamDeltas, Mode=TwoWay}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc property.real_sandbox}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.process_timeout_ms}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.SandboxTimeoutMs, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="30000" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_output_bytes}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.SandboxMaxOutputBytes, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="65536" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.memory_limit_mb}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.SandboxMaxMemoryMb, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="512" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.max_processes}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.SandboxMaxProcesses, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="8" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="{loc:Loc property.allow_web_fetch_network_access}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.SimulationEditor.SandboxAllowNetwork, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc property.allow_private_network_addresses}"
                          FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding SelectedBlock.SimulationEditor.SandboxAllowPrivateNetwork, Mode=TwoWay}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.python_executable}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.PythonExecutable, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="python" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.powershell_executable}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.PowerShellExecutable, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="powershell / pwsh" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.bash_executable}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.BashExecutable, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="bash" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc common.tool_profile_optional}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.ToolProfileName, Mode=TwoWay}"
                             FontSize="11" Padding="8,6"
                             Watermark="{loc:Loc property.tool_profile_block_name}" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc property.tool_rules}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.allowed_tools}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SimulationEditor.AllowedToolsText, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="python, web_fetch" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.tool_timeout_ms}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.ToolTimeoutMs, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="30000" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Loc property.tool_max_retries}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.ToolMaxRetries, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="1" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Loc property.tool_retry_delay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.SimulationEditor.ToolRetryDelayMs, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{loc:Loc property.abort_on_tool_failure}"
                              FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom"
                              IsChecked="{Binding SelectedBlock.SimulationEditor.AbortOnToolFailure, Mode=TwoWay}" />
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.simulated_tools}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedBlock.SimulationEditor.Tools}" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimulationToolEditorViewModel">
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="6" Margin="0,2">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}"
                                                     FontSize="10" Padding="6,4" Watermark="tool_name" />
                                            <Button Grid.Column="1" Content="×"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveToolCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,0,0,0" Padding="6,2"
                                                    Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                        </Grid>
                                        <TextBox Text="{Binding Description, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Watermark="description" />
                                        <Grid ColumnDefinitions="*,8,*">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Behaviors}"
                                                      SelectedItem="{Binding Behavior, Mode=TwoWay}"
                                                      FontSize="10" HorizontalAlignment="Stretch" />
                                            <TextBox Grid.Column="2" Text="{Binding TimeoutMs, Mode=TwoWay}"
                                                     FontSize="10" Padding="6,4" Watermark="timeout ms" />
                                        </Grid>
                                        <TextBox Text="{Binding ParametersJson, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Height="48"
                                                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" />
                                        <TextBox Text="{Binding ResponseTemplate, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Watermark="response {{arguments}}" />
                                        <Grid ColumnDefinitions="*,8,*">
                                            <TextBox Grid.Column="0" Text="{Binding DelayMs, Mode=TwoWay}"
                                                     FontSize="10" Padding="6,4" Watermark="delay ms" />
                                            <TextBox Grid.Column="2" Text="{Binding FailuresBeforeSuccess, Mode=TwoWay}"
                                                     FontSize="10" Padding="6,4" Watermark="fail first N" />
                                        </Grid>
                                        <TextBox Text="{Binding ErrorMessage, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Watermark="error message" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Loc property.add_tool}"
                            Command="{Binding SelectedBlock.SimulationEditor.AddToolCommand}"
                            HorizontalAlignment="Left" Padding="10,5"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.script_turns}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding SelectedBlock.SimulationEditor.ScriptTurns}" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimulationScriptTurnEditorViewModel">
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="6" Margin="0,2">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Content, Mode=TwoWay}"
                                                     FontSize="10" Padding="6,4" Watermark="assistant content" />
                                            <Button Grid.Column="1" Content="×"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveScriptTurnCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,0,0,0" Padding="6,2"
                                                    Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                        </Grid>
                                        <TextBox Text="{Binding ToolCallsJson, Mode=TwoWay}"
                                                 FontSize="10" Padding="6,4" Height="56"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Consolas"
                                                 Watermark='[{"Name":"python","ArgumentsJson":"{}"}]' />
                                        <TextBlock Text="{Binding ToolCallsError}"
                                                   FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                                   IsVisible="{Binding ToolCallsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{loc:Loc property.add_turn}"
                            Command="{Binding SelectedBlock.SimulationEditor.AddScriptTurnCommand}"
                            HorizontalAlignment="Left" Padding="10,5"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Cleaner configuration -->
            <StackPanel Spacing="6"
                        IsVisible="{Binding SelectedBlock.CleanerEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.cleaner_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <ContentControl Content="{Binding SelectedBlock.CleanerEditor.Cleanup}"
                                ContentTemplate="{StaticResource CleanupRulesTemplate}" />

                <Button Content="{loc:Loc property.preview_cleaner_diff}"
                        Click="OnPreviewCleanerDiffClick"
                        HorizontalAlignment="Left" Padding="10,5" FontSize="10"
                        Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
            </StackPanel>

            <!-- SFT export configuration -->
            <StackPanel Spacing="6"
                        IsVisible="{Binding SelectedBlock.SftExportEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.sft_export_configuration}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.output_jsonl_path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding SelectedBlock.SftExportEditor.OutputPath, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Watermark="out/sft.jsonl" />
                        <Button Grid.Column="1" Content="{loc:Loc property.browse}"
                                Click="OnBrowseSftOutputClick"
                                FontSize="11" Padding="10,6"
                                Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.sft_export_fields}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.SftExportEditor.FieldsText, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="messages, tools" />
                    <TextBlock Text="{loc:Loc property.sft_export_fields_hint}"
                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedBlock.SftExportEditor.FieldsError}"
                               FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SelectedBlock.SftExportEditor.FieldsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="{loc:Loc property.preview_output}"
                            Click="OnPreviewSftOutputClick"
                            HorizontalAlignment="Left" Padding="10,5" FontSize="10"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Tool profile configuration -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding SelectedBlock.ToolProfileEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.tool_profile}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc property.profile_name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox Text="{Binding SelectedBlock.ToolProfileEditor.Name, Mode=TwoWay}"
                             FontSize="11" Padding="8,6" Watermark="agent_tools" />
                </StackPanel>

                <TextBlock Text="{loc:Loc common.tools}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <ListBox ItemsSource="{Binding SelectedBlock.ToolProfileEditor.Tools}"
                         SelectedItem="{Binding SelectedBlock.ToolProfileEditor.SelectedTool, Mode=TwoWay}"
                         Height="100" Background="{DynamicResource InputBackgroundBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolEditorViewModel">
                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc property.add_tool}" Command="{Binding SelectedBlock.ToolProfileEditor.AddToolCommand}"
                            Padding="10,5" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                    <Button Content="{loc:Loc property.remove_tool}" Command="{Binding SelectedBlock.ToolProfileEditor.RemoveSelectedToolCommand}"
                            Padding="10,5" Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>

                <StackPanel Spacing="6"
                            IsVisible="{Binding SelectedBlock.ToolProfileEditor.SelectedTool, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc property.tool_name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.Name, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc common.description}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.Description, Mode=TwoWay}"
                                 FontSize="11" Padding="8,6" Height="50"
                                 AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Loc property.parameters_json_schema}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox Text="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.ParametersJson, Mode=TwoWay}"
                                 FontSize="10" Padding="8,6" Height="100"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" />
                        <TextBlock Text="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.ParametersError}"
                                   FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.ParametersError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc property.parameter_tree}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Button Content="{loc:Loc property.add_parameter}"
                                Command="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.AddParameterCommand}"
                                Padding="8,4" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                    </StackPanel>

                    <TreeView ItemsSource="{Binding SelectedBlock.ToolProfileEditor.SelectedTool.Parameters}"
                              Height="220" Background="{DynamicResource InputBackgroundBrush}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:ToolParameterNodeViewModel"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" Width="90"
                                             FontSize="10" Padding="4,2" />
                                    <ComboBox ItemsSource="{Binding Types}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}"
                                              Width="90" FontSize="10" />
                                    <CheckBox Content="{loc:Loc property.req}" IsChecked="{Binding IsRequired, Mode=TwoWay}"
                                              FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBox Text="{Binding Description, Mode=TwoWay}" Width="120"
                                             FontSize="10" Padding="4,2" Watermark="{loc:Loc property.description}" />
                                    <Button Content="+" Command="{Binding AddChildCommand}"
                                            Padding="5,2" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                                    <Button Content="×" Command="{Binding RemoveCommand}"
                                            Padding="5,2" Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" />
                <TextBlock Text="{loc:Loc property.profile_json_import_export}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox Text="{Binding SelectedBlock.ToolProfileEditor.ProfileJson, Mode=TwoWay}"
                         FontSize="10" Padding="8,6" Height="130"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" />
                <TextBlock Text="{Binding SelectedBlock.ToolProfileEditor.ProfileJsonError}"
                           FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedBlock.ToolProfileEditor.ProfileJsonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc property.import_json}" Command="{Binding SelectedBlock.ToolProfileEditor.ImportJsonCommand}"
                            Padding="10,5" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
                    <Button Content="{loc:Loc property.export_json}" Command="{Binding SelectedBlock.ToolProfileEditor.ExportJsonCommand}"
                            Padding="10,5" Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}" />
                </StackPanel>

                <TextBlock Text="{loc:Loc property.simulation_llm_blocks_reference_this_profile_by}"
                           FontSize="10" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Generic JSON configuration editor -->
            <StackPanel Spacing="8">
                <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />
                <TextBlock Text="{loc:Loc property.config_json_advanced}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding SelectedBlock.ConfigJson, Mode=TwoWay}"
                         FontSize="11" Padding="8,6" Height="150"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         Watermark="{loc:Loc property.edit_the_block_config_as_json_and_press_apply}" />
                <TextBlock Text="{Binding SelectedBlock.ConfigJsonError}"
                           FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedBlock.ConfigJsonError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Content="{loc:Loc property.apply_config_json}"
                        Command="{Binding ApplyBlockConfigJsonCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="10,6" FontSize="11"
                        Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource ButtonSurfaceTextBrush}"
                        HorizontalContentAlignment="Center" />
            </StackPanel>

            <!-- Position -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc property.position}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <Grid ColumnDefinitions="*,8,*">
                    <TextBox Grid.Column="0" Text="{Binding SelectedBlock.X, Mode=TwoWay}"
                             FontSize="11" Padding="6,4" Watermark="X" />
                    <TextBox Grid.Column="2" Text="{Binding SelectedBlock.Y, Mode=TwoWay}"
                             FontSize="11" Padding="6,4" Watermark="Y" />
                </Grid>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />

            <!-- Output Ports -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc property.output_ports}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SelectedBlock.OutputPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PortViewModel">
                            <Border Background="{DynamicResource NodeBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DataType}" FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Input Ports -->
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc property.input_ports}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SelectedBlock.InputPorts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PortViewModel">
                            <Border Background="{DynamicResource NodeBackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DataType}" FontSize="10"
                                               Foreground="{DynamicResource TextDimBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" />

            <!-- Actions -->
            <StackPanel Spacing="6">
                <Button Content="{loc:Loc property.delete_block}" Command="{Binding DeleteSelectedBlockCommand}"
                        HorizontalAlignment="Stretch"
                        Padding="8,6" FontSize="11"
                        Background="{DynamicResource DangerSurfaceBrush}" Foreground="{DynamicResource DangerBrush}"
                        HorizontalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Separator -->
        <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" Margin="0,8" />

        <!-- Recipe validation issues -->
        <StackPanel Spacing="4" IsVisible="{Binding HasValidationIssues}">
            <TextBlock Text="{loc:Loc property.validation_issues}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ValidationIssueViewModel">
                        <Button Command="{Binding LocateCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,5" Margin="0,2"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                CornerRadius="4"
                                ToolTip.Tip="{loc:Loc property.select_the_block_that_owns_this_issue}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding SeverityText}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsError}" />
                                <TextBlock Text="{Binding SeverityText}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsWarning}" />
                                <TextBlock Text="{Binding SeverityText}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDimBrush}" IsVisible="{Binding IsInfo}" />
                                <TextBlock Text="{Binding Message}" FontSize="10"
                                           Foreground="{DynamicResource TextBrightBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Separator -->
        <Border Height="1" Background="{DynamicResource ButtonSurfaceBrush}" Margin="0,8" />

        <!-- Log Messages -->
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc common.logs}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="8" MinHeight="80" MaxHeight="200">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding LogMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
